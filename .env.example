# Copie este arquivo para ".env" (que NÃO é enviado ao Git) e preencha com seus dados reais.

# Credenciais da API de afiliados Shopee (painel de afiliado > API oficial)
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# Normalmente não precisa mudar estes dois:
SHOPEE_AFFILIATE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
SHOPEE_HOME_URL=https://shopee.com.br/

# Percentual da comissão da Shopee repassado ao usuário como cashback (100 = repassa tudo)
SHOPEE_CASHBACK_PERCENTUAL=100

# Percentual de comissão que a Shopee paga pra vendas diretas, sem contar bônus de campanha
# do vendedor. A Shopee reajusta esse valor todo mês (varia entre 8% e 10%) - atualize aqui
# com o piso do mês. O "até X%" anunciado no hero é calculado como
# SHOPEE_CASHBACK_PERCENTUAL x SHOPEE_COMISSAO_VENDA_DIRETA (não precisa configurar à parte).
SHOPEE_COMISSAO_VENDA_DIRETA=8

# Multiplicador pra campanhas promocionais PRÓPRIAS do cash-b (ex: "cashback em dobro" no
# mês de aniversário) - não tem relação com bônus de vendedor da Shopee. Deixe em 1 fora de
# campanha. Afeta o cashback pago de verdade (pedidos/ofertas), não só o número do hero.
CASHBACK_MULTIPLICADOR_CAMPANHA=1

# API do Gemini (aistudio.google.com > Get API key) - usada só pra encurtar o nome dos
# produtos exibidos na aba Ofertas. Sem preencher, o site usa o nome original da Shopee
# sem encurtar (não quebra nada).
GEMINI_API_KEY=
# Normalmente não precisa mudar (a Google descontinua/troca o nome do modelo de vez em
# quando - se aparecer erro "no longer available", veja o modelo atual em ai.google.dev):
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite

# Credenciais da API da Asaas (conta sandbox > Integrações > Chave de API)
ASAAS_API_KEY=

# Normalmente não precisa mudar (troque pela URL de produção só quando for pra produção de verdade):
ASAAS_API_URL=https://sandbox.asaas.com/api/v3

# Token do mecanismo de segurança "webhook de validação de transferência" da Asaas -
# alternativa ao código por SMS pra autorizar transferências PIX. Cadastre em Menu do
# usuário > Integrações > Mecanismos de segurança, com a URL
# https://SEU-DOMINIO/saques/webhook/validacao/ e o mesmo valor de token aqui embaixo
# (gere uma string aleatória longa, ex: com `openssl rand -hex 32`).
ASAAS_WEBHOOK_TOKEN=

# Credenciais da API Banking do Inter (Internet Banking > Soluções para sua empresa >
# Nova integração, escopos pagamento-pix.write e pagamento-pix.read). Autenticação
# usa certificado mTLS além do client_id/secret - baixe os arquivos .crt/.key pelo
# Internet Banking e NUNCA os commite no repositório (coloque fora da pasta do
# projeto, ou numa pasta ignorada pelo git, e aponte o caminho completo aqui).
#
# EM PAUSA: conta MEI não tem acesso a "Soluções para sua empresa" nem pode abrir
# conta PJ - só dá pra preencher isso depois de migrar de MEI pra Simples Nacional.
# A Asaas é o provedor em uso de fato enquanto isso.
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=
INTER_KEY_PATH=
# Só preencher se a aplicação estiver associada a mais de uma conta corrente.
INTER_CONTA_CORRENTE=
# Normalmente não precisa mudar (troque pela URL de produção só quando for pra produção de verdade):
INTER_API_URL=https://cdpj-sandbox.partners.uatinter.co

# Valor mínimo, em reais, para o usuário poder solicitar saque via PIX
SAQUE_VALOR_MINIMO=20.00

# Configurações do Django (opcional em desenvolvimento)
DJANGO_DEBUG=True

# Só preencher em produção, se o serviço tiver um Disk persistente do Render montado
# (ex: /var/data) - sem isso, usa a pasta "media" dentro do próprio projeto (não
# persiste entre deploys/reinícios no plano sem disco).
MEDIA_ROOT=

# Envio de e-mail (usado no "esqueceu sua senha"), via API HTTP do Brevo -
# painel do Brevo > SMTP & API > aba "API Keys" (não é a senha SMTP).
# Sem preencher, os e-mails só aparecem no terminal - ok pra desenvolvimento local.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=cash-b <contato@cash-b.com>
